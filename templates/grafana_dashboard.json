{
  "apiVersion": "v0alpha1",
  "kind": "Dashboard",
  "metadata": {
    "name": "sp-base-relay-v2-monitoring"
  },
  "spec": {
    "title": "SP-Base-Relay v2 Monitoring",
    "tags": ["rtcm", "gps", "relay", "multi-destination"],
    "timezone": "browser",
    "schemaVersion": 41,
    "version": 0,
    "refresh": "5s",
    "editable": true,
    "templating": {
      "list": [
        {
          "name": "destination",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(sp_base_relay_dest_connection_status, destination)",
          "multi": true,
          "includeAll": true,
          "refresh": 2,
          "current": { "text": "All", "value": "$__all" }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Service Overview",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sp_base_relay_service_uptime_seconds",
            "legendFormat": "Service Uptime",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "value": null, "color": "green" }]
            }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "textMode": "value_and_name",
          "graphMode": "none",
          "colorMode": "value"
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Active Destinations",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [
          {
            "expr": "sp_base_relay_active_destinations_count",
            "legendFormat": "Connected",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 1, "color": "yellow" },
                { "value": 2, "color": "green" }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "textMode": "value_and_name",
          "graphMode": "none",
          "colorMode": "background"
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Input Source",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "sp_base_relay_input_connection_status",
            "legendFormat": "GPS Input",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 0, "color": "red" },
                { "value": 1, "color": "green" }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "text": "Disconnected", "color": "red" },
                  "1": { "text": "Connected", "color": "green" }
                }
              }
            ]
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "textMode": "value_and_name",
          "graphMode": "none",
          "colorMode": "background"
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Broadcast Hub",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [
          {
            "expr": "sp_base_relay_hub_running_status",
            "legendFormat": "Hub",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 0, "color": "red" },
                { "value": 1, "color": "green" }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "text": "Stopped", "color": "red" },
                  "1": { "text": "Running", "color": "green" }
                }
              }
            ]
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "textMode": "value_and_name",
          "graphMode": "none",
          "colorMode": "background"
        }
      },
      {
        "id": 10,
        "type": "stat",
        "title": "Per-Destination Connection Status",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "sp_base_relay_dest_connection_status{destination=~\"$destination\"}",
            "legendFormat": "{{destination}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 0, "color": "red" },
                { "value": 1, "color": "green" }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "text": "Disconnected", "color": "red" },
                  "1": { "text": "Connected", "color": "green" }
                }
              }
            ]
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "textMode": "value_and_name",
          "graphMode": "none",
          "colorMode": "background",
          "orientation": "horizontal"
        }
      },
      {
        "id": 20,
        "type": "timeseries",
        "title": "Bytes Sent per Destination",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "rate(sp_base_relay_dest_bytes_sent_total{destination=~\"$destination\"}[1m])",
            "legendFormat": "{{destination}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 15,
              "showPoints": "never"
            },
            "color": { "mode": "palette-classic" }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
        }
      },
      {
        "id": 21,
        "type": "timeseries",
        "title": "Messages Sent per Destination",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "rate(sp_base_relay_dest_messages_sent_total{destination=~\"$destination\"}[1m])",
            "legendFormat": "{{destination}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 15,
              "showPoints": "never"
            },
            "color": { "mode": "palette-classic" }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
        }
      },
      {
        "id": 30,
        "type": "timeseries",
        "title": "Queue Depth per Destination",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "sp_base_relay_dest_queue_depth{destination=~\"$destination\"}",
            "legendFormat": "{{destination}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "never",
              "thresholdsStyle": { "mode": "line" }
            },
            "color": { "mode": "palette-classic" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 50, "color": "yellow" },
                { "value": 90, "color": "red" }
              ]
            },
            "min": 0,
            "max": 100
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 31,
        "type": "timeseries",
        "title": "Messages Dropped per Destination",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "rate(sp_base_relay_dest_messages_dropped_total{destination=~\"$destination\"}[5m]) * 60",
            "legendFormat": "{{destination}} drops/min",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "never"
            },
            "color": { "mode": "palette-classic" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 1, "color": "yellow" },
                { "value": 10, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 40,
        "type": "timeseries",
        "title": "Connection Attempts per Destination",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
        "targets": [
          {
            "expr": "sp_base_relay_dest_connection_attempts_total{destination=~\"$destination\"}",
            "legendFormat": "{{destination}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 1,
              "fillOpacity": 10,
              "showPoints": "never"
            },
            "color": { "mode": "palette-classic" }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 41,
        "type": "timeseries",
        "title": "Errors per Destination",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
        "targets": [
          {
            "expr": "rate(sp_base_relay_dest_errors_total{destination=~\"$destination\"}[5m]) * 60",
            "legendFormat": "{{destination}} errors/min",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "never"
            },
            "color": { "mode": "palette-classic" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 1, "color": "yellow" },
                { "value": 5, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 50,
        "type": "timeseries",
        "title": "Input — Seconds Since Last Data (DR-7 Watchdog)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "targets": [
          {
            "expr": "sp_base_relay_input_seconds_since_last_data",
            "legendFormat": "Seconds since last GPS data",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 20,
              "showPoints": "never",
              "thresholdsStyle": { "mode": "line" }
            },
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 10, "color": "yellow" },
                { "value": 30, "color": "red" }
              ]
            },
            "min": 0
          }
        },
        "options": {
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 51,
        "type": "stat",
        "title": "Messages Filtered per Destination",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
        "targets": [
          {
            "expr": "sp_base_relay_dest_messages_filtered_total{destination=~\"$destination\"}",
            "legendFormat": "{{destination}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "value": null, "color": "blue" }]
            }
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "textMode": "value_and_name",
          "graphMode": "area",
          "colorMode": "value",
          "orientation": "horizontal"
        }
      }
    ],
    "annotations": { "list": [] },
    "time": { "from": "now-6h", "to": "now" },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    },
    "links": []
  }
}
