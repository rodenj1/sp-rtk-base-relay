[Unit]
Description=SP-Base-Relay - RTCM Correction Data Relay Service
Documentation=https://github.com/rodenj1/sp-base-relay
After=network-online.target bluetooth-gps.service
Wants=network-online.target
# Tight coupling: If bluetooth-gps stops/restarts, we stop/restart too
BindsTo=bluetooth-gps.service
PartOf=bluetooth-gps.service

[Service]
Type=simple
User=sp-base-relay
Group=sp-base-relay

# Pre-start validation: Ensure /dev/rfcomm0 exists and is readable
# Wait up to 5 seconds for device to become available
ExecStartPre=/bin/sh -c 'for i in 1 2 3 4 5; do test -e /dev/rfcomm0 && break || sleep 1; done'
ExecStartPre=/bin/sh -c 'test -e /dev/rfcomm0 || { echo "WARNING: /dev/rfcomm0 does not exist"; exit 0; }'

# Service execution
ExecStart=/usr/local/bin/sp-base-relay --config /etc/sp-base-relay/config.yaml --foreground
ExecReload=/bin/kill -HUP $MAINPID

# Working directory
WorkingDirectory=/var/lib/sp-base-relay

# Security and resource limits
# Run as dedicated user/group
NoNewPrivileges=true

# File system access
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sp-base-relay /var/log/sp-base-relay

# Network access (required for TCP connections)
PrivateNetwork=false

# Process limits
LimitNOFILE=65536

# Restart behavior - Faster recovery for Bluetooth failures
Restart=on-failure
RestartSec=15
StartLimitInterval=600
StartLimitBurst=10

# On service stop/failure, trigger bluetooth-gps restart for recovery
ExecStopPost=/bin/sh -c 'systemctl is-active bluetooth-gps.service >/dev/null && systemctl restart bluetooth-gps.service || true'

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sp-base-relay

# Environment
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
