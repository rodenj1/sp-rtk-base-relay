[Unit]
Description=SP-Base-Relay - RTCM Correction Data Relay Service
Documentation=https://github.com/rodenj1/sp-base-relay
After=network-online.target bluetooth-gps.service
Wants=network-online.target
# Tight coupling: If bluetooth-gps stops/restarts, we stop/restart too
BindsTo=bluetooth-gps.service
PartOf=bluetooth-gps.service

[Service]
Type=simple
User=sp-base-relay
Group=sp-base-relay

# Service execution
# Note: Update ExecStart path to match your installation
ExecStart=/usr/local/bin/sp-base-relay --config /etc/sp-base-relay/config.yaml --foreground
ExecReload=/bin/kill -HUP $MAINPID

# Working directory
WorkingDirectory=/var/lib/sp-base-relay

# Restart behavior - Faster recovery for Bluetooth failures
Restart=on-failure
RestartSec=15
StartLimitInterval=600
StartLimitBurst=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sp-base-relay

# Environment
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
