  "id": null,
  "uid": "sp-base-relay-v2",
  "title": "SP-Base-Relay v2 Monitoring",
  "description": "Multi-destination RTCM relay monitoring with per-destination metrics",
  "tags": ["rtcm", "gps", "relay", "multi-destination"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sp_base_relay_service_uptime_seconds",
          "legendFormat": "Service Uptime",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "textMode": "value_and_name",
        "graphMode": "none",
        "colorMode": "value",
        "orientation": "auto"
      }
    },
