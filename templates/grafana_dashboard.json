                {
                  "value": 8,
                  "color": "yellow"
                },
                {
                  "value": 12,
                  "color": "red"
                }
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "id": 10,
        "type": "timeseries",
        "title": "Heartbeat Health Rate",
        "gridPos": {
          "h": 4,
          "w": 12,
          "x": 0,
          "y": 20
        },
        "targets": [
          {
            "expr": "rate(sp_base_relay_rtcm_heartbeat_last_received_timestamp[1m])",
            "legendFormat": "Heartbeat Rate (expected: ~1.0/sec)",
            "refId": "A"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "calcs": ["last", "mean"],
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "Heartbeats per Second",
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "thresholdsStyle": {
                "mode": "line"
              }
            },
            "color": {
              "mode": "thresholds"
            },
            "unit": "short",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 0.5,
                  "color": "yellow"
                },
                {
                  "value": 0.9,
                  "color": "green"
                }
              ]
            },
            "min": 0,
            "max": 1.2
          },
          "overrides": []
        }
      },
      {
        "id": 11,
        "type": "stat",
        "title": "Cumulative Statistics",
        "gridPos": {
          "h": 4,
          "w": 12,
          "x": 12,
          "y": 20
        },
        "targets": [
          {
            "expr": "sp_base_relay_rtcm_messages_sent_total",
            "legendFormat": "Total Messages Sent",
            "refId": "A"
          },
          {
            "expr": "sp_base_relay_rtcm_bytes_sent_total",
            "legendFormat": "Total Bytes Sent",
            "refId": "B"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "none",
          "colorMode": "value",
          "justifyMode": "auto",
          "orientation": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "blue"
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Total Bytes Sent"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "bytes"
                }
              ]
            }
          ]
        }
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "Relay Latency (Percentiles)",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(sp_base_relay_relay_latency_seconds_bucket[5m]))",
            "legendFormat": "p50 (median)",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(sp_base_relay_relay_latency_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(sp_base_relay_relay_latency_seconds_bucket[5m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "calcs": ["last", "mean", "max"],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "Latency",
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 0.01,
                  "color": "yellow"
                },
                {
                  "value": 0.1,
                  "color": "red"
                }
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "id": 13,
        "type": "stat",
        "title": "Relay Latency (Current)",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "targets": [
          {
            "expr": "rate(sp_base_relay_relay_latency_seconds_sum[5m]) / rate(sp_base_relay_relay_latency_seconds_count[5m])",
            "legendFormat": "Average Latency",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(sp_base_relay_relay_latency_seconds_bucket[5m]))",
            "legendFormat": "p95 Latency",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(sp_base_relay_relay_latency_seconds_bucket[5m]))",
            "legendFormat": "p99 Latency",
            "refId": "C"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "area",
          "colorMode": "value",
          "justifyMode": "auto",
          "orientation": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 4,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 0.01,
                  "color": "yellow"
                },
                {
                  "value": 0.1,
                  "color": "red"
                }
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "id": 14,
        "type": "bargauge",
        "title": "RTCM Messages by Type",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 32
        },
        "targets": [
          {
            "expr": "sum by (message_id) (rate(sp_base_relay_rtcm_messages_by_id_total[5m]))",
            "legendFormat": "ID {{message_id}}",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true,
          "valueMode": "color"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "blue"
                }
              ]
            },
            "min": 0
          },
          "overrides": []
        }
      },
      {
        "id": 15,
        "type": "stat",
        "title": "Message Decode Health",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 32
