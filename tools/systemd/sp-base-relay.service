[Unit]
Description=SP-Base-Relay - RTCM Correction Data Relay Service
Documentation=https://github.com/rodenj1/sp-base-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sp-base-relay
Group=sp-base-relay

# Service execution
ExecStart=/usr/local/bin/sp-base-relay --config /etc/sp-base-relay/config.yaml --foreground
ExecReload=/bin/kill -HUP $MAINPID

# Working directory
WorkingDirectory=/var/lib/sp-base-relay

# Security and resource limits
# Run as dedicated user/group
NoNewPrivileges=true

# File system access
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sp-base-relay /var/log/sp-base-relay

# Network access (required for TCP connections)
PrivateNetwork=false

# Process limits
LimitNOFILE=65536

# Restart behavior
Restart=always
RestartSec=60
StartLimitInterval=600
StartLimitBurst=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sp-base-relay

# Environment
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
