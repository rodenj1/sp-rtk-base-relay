      {
        "name": "destination",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(sp_base_relay_dest_connection_status, destination)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(sp_base_relay_dest_connection_status, destination)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
