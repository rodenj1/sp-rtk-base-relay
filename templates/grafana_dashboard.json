{
  "apiVersion": "v0alpha1",
  "kind": "Dashboard",
  "metadata": {
    "name": "sp-base-relay-monitoring"
  },
  "spec": {
    "title": "SP-Base-Relay Monitoring",
    "tags": ["rtcm", "gps", "relay"],
    "timezone": "browser",
    "schemaVersion": 41,
    "version": 0,
    "refresh": "5s",
    "editable": true,
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Connection Status",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sp_base_relay_rtcm_connection_status",
            "legendFormat": "RTCM Server",
            "refId": "A"
          },
          {
            "expr": "sp_base_relay_input_connection_status",
            "legendFormat": "Input Source",
            "refId": "B"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "none",
          "colorMode": "background",
          "justifyMode": "auto",
          "orientation": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 1,
                  "color": "green"
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "Disconnected",
                    "color": "red"
                  },
                  "1": {
                    "text": "Connected",
                    "color": "green"
                  }
                }
              }
            ]
          },
          "overrides": []
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Pipeline Status",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "sp_base_relay_pipeline_running_status",
            "legendFormat": "Pipeline",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "none",
          "colorMode": "background",
          "justifyMode": "auto",
          "orientation": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 1,
                  "color": "green"
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "Stopped",
                    "color": "red"
                  },
                  "1": {
                    "text": "Running",
                    "color": "green"
                  }
                }
              }
            ]
          },
          "overrides": []
        }
      },
