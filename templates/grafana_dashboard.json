      {
        "id": 9,
        "type": "stat",
        "title": "Pipeline Restarts",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 12
        },
        "targets": [
          {
            "expr": "increase(sp_base_relay_pipeline_restarts_total[1h])",
            "legendFormat": "Restarts per Hour",
            "refId": "A"
